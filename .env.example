# Environment variables for KeyHome frontend
# Copy this file to .env.local and fill in real values
# Production: set NEXT_PUBLIC_API_URL to your API base (e.g. https://api.keyhome.fr/api/v1)

# Préférez 127.0.0.1 si « timeout » en dev : certains OS résolvent localhost en IPv6 alors que PHP écoute en IPv4.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Optional: Axios timeout (ms) for POST /ads/{id}/tour/scenes (heavy multipart). Default 600000 (10 min). Max 1800000 (30 min).
# NEXT_PUBLIC_API_TOUR_UPLOAD_TIMEOUT_MS=600000
# Optional: if NEXT_PUBLIC_API_URL is unset at build time, Next uses this for /tour-proxy server rewrites (Laravel origin)
# TOUR_PROXY_BACKEND_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# Clerk authentication — get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Filament panel URLs (full URLs to Laravel backend panels)
NEXT_PUBLIC_AGENCY_URL=http://localhost:8000/agency
NEXT_PUBLIC_OWNER_URL=http://localhost:8000/owner
NEXT_PUBLIC_ADMIN_URL=http://localhost:8000/admin
# Bailleur UI: `next` = this app’s /owner/login (same host as the marketing site). `laravel` = Filament URL built from NEXT_PUBLIC_OWNER_URL.
# If unset, Laravel is assumed only when NEXT_PUBLIC_OWNER_URL contains :8000 (local Filament).
NEXT_PUBLIC_OWNER_PANEL=

# Web Push (VAPID public key from Laravel backend — generate with: php artisan webpush:vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# En local, enregistrer /sw.js (push + PWA) : NEXT_PUBLIC_ENABLE_SW=1
# NEXT_PUBLIC_ENABLE_SW=1

# Contact
NEXT_PUBLIC_WHATSAPP_NUMBER=237657507909
