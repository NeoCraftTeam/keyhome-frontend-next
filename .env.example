# Environment variables for KeyHome frontend
# Copy this file to .env.local and fill in real values
# Production: set NEXT_PUBLIC_API_URL to your API base (e.g. https://api.keyhome.fr/api/v1)

# Préférez 127.0.0.1 si « timeout » en dev : certains OS résolvent localhost en IPv6 alors que PHP écoute en IPv4.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Canonical site URL for SEO: sitemap, metadata, JSON-LD (no trailing slash). Production: https://keyhome.app
# NEXT_PUBLIC_SITE_URL=https://keyhome.app
# Owner panel subdomain (optional). When set, proxy.ts routes owner.keyhome.app/* → /owner/*.
# Production: NEXT_PUBLIC_OWNER_HOSTNAME=owner.keyhome.app
# Leave unset in local dev (owner panel stays accessible at /owner/* on localhost).
# NEXT_PUBLIC_OWNER_HOSTNAME=owner.keyhome.app
# Site ownership (HTML meta tags) — Search Console / Bing Webmaster
# Google: Property → Verification → HTML tag → copy content= value only
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing: verify with Meta tag → copy content for msvalidate.01 only
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
#
# Google Tag Manager — optional. Format GTM-XXXXXXX (validated at build/runtime).
# Required for CSP: bootstrap script uses nonce from edge proxy (`x-nonce`); frame-src allows GTM iframe.
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# Optional: Axios timeout (ms) for POST /ads/{id}/tour/scenes (heavy multipart). Default 600000 (10 min). Max 1800000 (30 min).
# NEXT_PUBLIC_API_TOUR_UPLOAD_TIMEOUT_MS=600000
# Optional: if NEXT_PUBLIC_API_URL is unset at build time, Next uses this for /tour-proxy server rewrites (Laravel origin)
# TOUR_PROXY_BACKEND_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# Clerk authentication — get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Filament panel URLs (full URLs to Laravel backend panels)
NEXT_PUBLIC_AGENCY_URL=http://localhost:8000/agency
NEXT_PUBLIC_OWNER_URL=http://localhost:8000/owner
NEXT_PUBLIC_ADMIN_URL=http://localhost:8000/admin
# Bailleur UI: `next` = this app’s /owner/login (same host as the marketing site). `laravel` = Filament URL built from NEXT_PUBLIC_OWNER_URL.
# If unset, Laravel is assumed only when NEXT_PUBLIC_OWNER_URL contains :8000 (local Filament).
NEXT_PUBLIC_OWNER_PANEL=

# Web Push (VAPID public key from Laravel backend — generate with: php artisan webpush:vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# En local, enregistrer /sw.js (push + PWA) : NEXT_PUBLIC_ENABLE_SW=1
# NEXT_PUBLIC_ENABLE_SW=1

# Contact
NEXT_PUBLIC_WHATSAPP_NUMBER=237657507909

# Cloudflare Turnstile — optional public site key inlined at build time.
# If empty, the app loads the key from GET {NEXT_PUBLIC_API_URL}/config/turnstile
# (same value as TURNSTILE_SITE_KEY on the Laravel API) so Vercel does not need
# this variable when the API is already configured.
# Leave empty to skip the CAPTCHA in dev when the API has no site key (backend fails open).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Clerk OAuth — afficher le bouton GitHub uniquement si true ET provider activé dans Clerk.
# Évite erreurs runtime quand GitHub n'est pas configuré sur l'instance Clerk.
# GitHub is shown by default when using Clerk SSO. Disable if Clerk has no GitHub app:
# NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=false

# Stripe — clé publique (pk_test_* en dev/test, pk_live_* en prod).
# Doit correspondre au compte Stripe de la clé secrète configurée côté Laravel
# (STRIPE_SECRET dans le .env du backend). Sans cette variable, le composant
# `<StripeConfirmStep>` affiche « Paiement par carte indisponible ».
# IMPORTANT Vercel : NEXT_PUBLIC_* est inliné au build → après modification,
# il faut REDÉPLOYER (Deployments → Redeploy) pour que la valeur soit prise.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Currency conversion (geo-aware visitor pricing)
# ExchangeRate-API key — server-only (never exposed to the browser).
# Free tier: 1500 req/month at https://www.exchangerate-api.com/
# When unset, /api/exchange-rates falls back to the keyless open.er-api.com
# provider, then to a static rate snapshot. The feature stays functional
# without this key — only the freshness of rates may degrade.
EXCHANGE_API_KEY=

# Sentry error tracking — https://sentry.io
# NEXT_PUBLIC_ prefix required for client-side (instrumentation-client.ts)
# Sentry is only enabled when NODE_ENV=production
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
